      "item": [
        {
          "name": "POST - Criar usuário",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufixo = Math.floor(100000 + Math.random() * 899999);",
                  "pm.collectionVariables.set('usuarioLogin', 'fiscal.' + sufixo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const resposta = pm.response.json();",
                  "  if (resposta.id !== undefined) pm.collectionVariables.set('usuarioId', resposta.id);",
                  "  if (resposta.login !== undefined) pm.collectionVariables.set('usuarioLogin', resposta.login);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Fiscal de Tributos\",\n  \"login\": \"{{usuarioLogin}}\",\n  \"senha\": \"Fiscal123\",\n  \"nivelAcesso\": \"FISCAL\"\n}",
